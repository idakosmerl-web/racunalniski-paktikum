Cell[TextData[{
 "Na kocko s stranico ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "b5f3e715-e0d6-4f56-88ba-fdead7faa6c7"],
 " postavimo drugo kocko s telesno diagonalo, enako stranici prve kocke, na \
drugo kocko spet tretjo s telesno diagonalo, enako stranici druge kocke, in \
to ponavljamo brez konca. Izra\[CHacek]unajte vi\[SHacek]ino tako dobljenega \
telesa: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "0"}], "\[Infinity]", 
          LimitsPositioning -> True], 
         FractionBox[
          StyleBox["a", "TI"], 
          SuperscriptBox[
           SqrtBox["3"], 
           StyleBox["i", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum_{i=0}^\\infty \\frac{a}{\\sqrt{3}^i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a15efc02-9cbb-4330-b1ff-8d02d41d8adb"],
 "."
}], "Text",
