Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "prostor", " ", "za", " ", "va\[SHacek]e", " ", "re\[SHacek]itve"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]", " ", "=", " ", 
     RowBox[{"1830", " ", "\[Degree]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]", "=", 
     RowBox[{"270", "\[Degree]"}]}], ";"}], "\[IndentingNewLine]", 
   FractionBox[
    RowBox[{
     RowBox[{"Sin", "[", "\[Alpha]", "]"}], "+", 
     RowBox[{"Sin", "[", "\[Beta]", "]"}]}], 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"\[Alpha]", "-", "\[Beta]"}], "]"}], "^", "2"}], "-", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"\[Beta]", "-", "\[Alpha]"}], "]"}], "^", 
      "2"}]}]]}]}]], "Input",
 CellChangeTimes->{
  3.942731862879264*^9, {3.9781840854734898`*^9, 3.978184291221834*^9}, {
   3.9781843344407883`*^9, 3.978184339625759*^9}},
