 " in njeni okraj\[SHacek]avi ",
 StyleBox["D", "Code"],
 " in ",
 StyleBox["\[OpenCurlyQuote]", "Code"],
 ".\[LineSeparator]Uporabite jo, da izra\[CHacek]unate:\n1. prvi in drugi \
odvod funkcije ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", "arctan", " "}], TraditionalForm]],ExpressionUUID->
